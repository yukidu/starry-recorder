{
  "expo": {
    "name": "繁星答錄機 RecordNote",
    "slug": "recordnote",
    "scheme": "recordnote",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "phd.starry.recordnote",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:id.starry.phd"
      ],
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)phd.starry.shared"
        ]
      }
    },
    "android": {
      "package": "phd.starry.recordnote",
      "versionCode": 1
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client"
    ],
    "extra": {
      "starryAppId": "recordnote"
    }
  }
}
